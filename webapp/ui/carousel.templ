package ui

import (
	"strings"
	"github.com/michalhercik/RecSIS/language"
)

type Translated struct {
	ViewAll string
	Title string
	Credits string
}

var i18n = map[language.Language]Translated{
	language.CS: {
		ViewAll: "Zobrazit vše",
		Credits: "Kr.",
	},
	language.EN: {
		ViewAll: "View All",
		Credits: "Cr.",
	},
}

type Carousel struct {
	ID string
	Lang language.Language
	Title string
	ViewAllURL string
	Courses []Course
}

func (c Carousel) T() Translated {
	return i18n[c.Lang]
}

type Course struct {
	Code string
	Title string
	Guarantors []string
	Semester string
	Credits int
	URL string
}

var carouselHandle = templ.NewOnceHandle()


templ HorizontalCarousel(model Carousel) {
	@carouselHandle.Once() {
		@btnJavaScript()
  	}
	<div class="container py-1">
	  <!-- ================= Recommended ================= -->
	  <div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="fw-semibold mb-0">{ model.Title }</h5>
		<div class="d-flex align-items-center gap-2">
			if model.ViewAllURL != "" {
		    	<a href={ templ.URL(model.ViewAllURL) } class="small text-decoration-none text-nowrap">{ model.T().ViewAll }</a>
			}
		    <button class="scroll-btn left" style="width:44px; height:40px;" data-target={ model.ID } onclick="scrollRow(this.dataset.target, -1)">
		      <i class="bi bi-chevron-left"></i>
		    </button>
		    <button class="scroll-btn right" style="width:44px; height:40px;" data-target={ model.ID } onclick="scrollRow(this.dataset.target, 1)">
		      <i class="bi bi-chevron-right"></i>
		    </button>
		</div>
	  </div>

	  <div class="position-relative">
		<div class="d-flex gap-2 overflow-hidden pb-2" id={ model.ID } style="scroll-behavior:smooth;">
	      <!-- cards from model.Courses -->
	      for _, course := range model.Courses {
	        <div class="card p-3 shadow-sm flex-shrink-0" style="min-width:240px; max-width:240px; border-radius:12px;">
	          <div class="text-muted small fw-semibold">{ course.Code }</div>
	          <div class="mt-1">
	            <div class="fw-semibold" style="font-size:1rem;">@titleCourseLink(course)</div>
	          </div>
	          <div class="text-muted small mt-1">{ strings.Join(course.Guarantors, ", ")}</div>
	          <div class="mt-2">
	            <span class="badge bg-light text-dark me-1">{ course.Semester }</span>
	            <span class="badge bg-light text-dark me-1">{ course.Credits } {model.T().Credits}</span>
	          </div>
	        </div>
	      }
	    </div>
	  </div>
	</div>
	<script>
      (() => {
        const container = document.getElementById({{ model.ID }});
        container.addEventListener('scroll', () => updateScrollButtons({{ model.ID }}));
        updateScrollButtons({{ model.ID }});
      })();
	</script>
}

templ btnJavaScript() {
	<script>
	  function scrollRow(id, direction) {
        const container = document.getElementById(id);

        container.scrollBy({
          left: direction * (container.clientWidth * 0.9),
          behavior: 'smooth'
        });
      }

      function updateScrollButtons(id) {
        const container = document.getElementById(id);

        const leftBtn = document.querySelector(
          `.scroll-btn.left[data-target="${id}"]`
        );
        const rightBtn = document.querySelector(
          `.scroll-btn.right[data-target="${id}"]`
        );

        leftBtn.disabled = container.scrollLeft <= 0;

        rightBtn.disabled =
          container.scrollLeft + container.clientWidth >=
          container.scrollWidth - 1;
      }
	</script>
}

templ titleCourseLink(course Course) {
	<a
		class={ "link-body-emphasis link-underline-opacity-0 link-underline-opacity-75-hover" }
		href={ templ.SafeURL(course.URL) }
	>
		{ course.Title }
	</a>
}
