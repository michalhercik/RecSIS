package receval

import "fmt"
import "slices"

func mapColorsSingle(flags []bool, colorClass string) []string {
	var result []string = make([]string, len(flags))
	for i, flag := range flags {
		if !flag {
			result[i] = colorClass
		}
	}
	return result
}

